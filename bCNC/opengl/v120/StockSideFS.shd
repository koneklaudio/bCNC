#version 120

uniform vec3 light1dir;
uniform vec3 light2dir;

uniform sampler2D heightMap;

varying float s;
varying float z;

uniform float side; // 1: up, 2: down, 3: left, 4: right

void main() {
    float h;
    vec3 normal;

    if (side == 1)
    {
        h = texture2D(heightMap, vec2(s, 1.0)).r;
        normal = vec3(0., 1., 0.);
    }
    else if (side == 2)
    {
        h = texture2D(heightMap, vec2(s, 0.0)).r;
        normal = vec3(0., -1., 0.);
    }
    else if (side == 3)
    {
        h = texture2D(heightMap, vec2(0.0, s)).r;
        normal = vec3(-1., 0., 0.);
    }
    else if (side == 4)
    {
        h = texture2D(heightMap, vec2(1.0, s)).r;
        normal = vec3(1., 0., 0.);
    }

    if (z > h)
    {
        discard;
    }
    
    vec3 baseColor = vec3(0.82, 0.50, 0.19);

    float diffuse = abs((dot(normal, light1dir) + dot(normal, light2dir)) / 2.);

    float lighting = 0.25 + 0.75 * diffuse;

    gl_FragColor = vec4(baseColor * lighting, 1.0);
}